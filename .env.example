# Server-side OpenAI API key for GPT-6 Luna.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Public URL path where this app is served on the domain.
APP_BASE_PATH="/HomeMeal"

# PostgreSQL connection string from your managed database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Local development origin; set this to the exact production domain in Vercel.
APP_ORIGIN="http://localhost:3000"

# Set these locally only when creating the first administrator, then remove them.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="HomeMeal Admin"

# Email verification and password reset (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HomeMeal <noreply@your-verified-domain.com>"

# Strong random values for server-side authentication.
AUTH_RATE_LIMIT_SECRET=""

# Private S3-compatible object storage for receipts (AWS S3, Cloudflare R2, etc.)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Deployment observability and local order scheduling
SENTRY_DSN=""
APP_TIME_ZONE="Asia/Ho_Chi_Minh"
